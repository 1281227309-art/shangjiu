# 派生/可重建的产物，不进版本库（避免把仓库撑大）
# 重建方式见 DEPLOY.md / 本文件下方注释

# axe-core：第三方审计工具，体积 544K，可用下面一行还原
#   npm_config_cache=/tmp/npmcache npm pack axe-core@4.10.2 && tar xzf axe-core-*.tgz \
#     && cp package/axe.min.js tools/vendor/axe.min.js
tools/vendor/axe.min.js

# 部署包：由 deploy/design-preview.html 重新打包即可
deploy/*.tar.gz

# ⚠ 覆盖根目录 .gitignore 里的 `dist/`
# 那条规则本意是忽略构建产物，却会连坐到这里 —— 而 vendor/pretext/dist
# 是 Pretext 的上游源码（未修改），是重建 pretext.iife.js 的唯一输入，
# 必须入库，否则 `node tools/build.mjs` 无法复现。
!vendor/pretext/dist/
!vendor/pretext/dist/**
